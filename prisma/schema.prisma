// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  // если собираешь клиент вне сервера и деплоишь — оставь оба таргета
  // binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum OrderStatus {
  DRAFT // создан, но ещё без оплаты
  PENDING // платёж инициирован / ожидаем
  NEW // новый заказ
  PROCESSING // в обработке
  PAID // оплачен
  COMPLETED // завершён
  CANCELLED // отменён
}

enum PromoType {
  PERCENT // скидка в %
  FIXED // скидка в деньгах (в копейках/тиынах)
}

enum AppliesTo {
  ALL
  CATEGORY
  PRODUCTS
}

enum PaymentMethod {
  KASPI_QR
  CARD
  CASH
  INVOICE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED // зарезервировано, возврат пока не реализуется
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  phone        String?
  role         Role      @default(USER)
  isBlocked    Boolean   @default(false)
  orders       Order[]
  sessions     Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")

  products   Product[]
  promoCodes PromoCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String? @db.Text
  price       Int // деньги ХРАНИМ в целых (тиынах/копейках)
  oldPrice    Int?
  sku         String? @unique
  stock       Int     @default(0)
  images      Json    @default("[]") // массив URL/путей
  attrs       Json    @default("{}") // произвольные характеристики (цвет/размер и т.п.)
  isActive    Boolean @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, createdAt])
}

model PromoCode {
  code       String    @id
  type       PromoType
  value      Int
  appliesTo  AppliesTo @default(ALL)
  categoryId String?
  productIds String[]
  startsAt   DateTime?
  endsAt     DateTime?
  usageLimit Int?
  used       Int       @default(0)

  category Category? @relation(fields: [categoryId], references: [id]) // back-relation теперь есть в Category

  promoRedemptions PromoRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appliesTo, categoryId])
  @@index([endsAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id]) // back-relation теперь есть в Product

  title String
  sku   String?
  price Int
  qty   Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Order {
  id     String  @id @default(cuid())
  number String  @unique // человеко-читаемый номер, например BG-2025-0001
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  status        OrderStatus    @default(NEW)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  paymentRef    String? // внешний ID платежа (например Kaspi)
  adminComment  String?

  customerName    String
  customerPhone   String
  customerComment String?

  subtotal      Int // без скидок
  discountTotal Int @default(0)
  total         Int // к оплате (>=0)

  items            OrderItem[]
  payments         Payment[]
  promoRedemptions PromoRedemption[]
  statusHistory    OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Payment {
  id       String        @id @default(cuid())
  orderId  String
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider String
  method   PaymentMethod
  amount   Int
  currency String        @default("KZT")
  status   PaymentStatus @default(PENDING)

  providerRef String?
  rawPayload  Json?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model PromoRedemption {
  id             String    @id @default(cuid())
  promoCode      String
  promo          PromoCode @relation(fields: [promoCode], references: [code])
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Int

  createdAt DateTime @default(now())

  @@index([promoCode])
  @@index([orderId])
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus  OrderStatus?
  toStatus    OrderStatus
  comment     String?
  changedById String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

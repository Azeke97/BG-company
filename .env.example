# App
NODE_ENV=development
NUXT_PUBLIC_BASE_URL=/
NUXT_PUBLIC_RECAPTCHA=
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=

# PostgreSQL (local docker by default)
DATABASE_URL=postgresql://app:super_password@localhost:5433/bg_company?schema=public

# Google Sheets integration for /api/contact (optional for local)
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Лист1

# Admin seed account (used by `npm run db:seed`)
ADMIN_SEED_EMAIL=admin@bg.local
ADMIN_SEED_PASSWORD=admin12345
